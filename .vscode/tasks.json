{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "fusion-terms: extract candidates",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "pipeline.extract_candidates",
                "--config",
                "${workspaceFolder}/config.toml"
            ],
            "problemMatcher": []
        },
        {
            "label": "fusion-terms: build final wordlist",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "pipeline.build_terms",
                "--config",
                "${workspaceFolder}/config.toml"
            ],
            "problemMatcher": []
        },
        {
            "label": "fusion-terms: sync to fcitx wordlists",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "pipeline.sync_to_fcitx"
            ],
            "problemMatcher": []
        },
        {
            "label": "fusion-terms: generate rime import file",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "pipeline.rime_import_safe"
            ],
            "problemMatcher": []
        },
        {
            "label": "fusion-terms: generate + import to Rime",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "pipeline.rime_import_safe",
                "--import",
                // Safety: back up whichever of these paths exists before importing.
                // If none exist, rime_import_safe will refuse to import.
                "--backup-path",
                "~/.local/share/fcitx/rime",
                "--backup-path",
                "~/.local/share/fcitx5/rime",
                "--backup-path",
                "~/.config/fcitx/rime",
                "--backup-path",
                "~/.config/fcitx5/rime"
            ],
            "problemMatcher": []
        },
        {
            "label": "fusion-terms: rebuild all downstream",
            "dependsOrder": "sequence",
            "dependsOn": [
                "fusion-terms: rebuild all downstream (run)"
            ],
            "problemMatcher": []
        },
        {
            "label": "fusion-terms: rebuild all downstream (run)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "set -e && python3 -m pipeline.export_registry --query-expansions --tag-rules --substitutions --vale-substitute --translation-dict && python3 -m pipeline.build_terms --config ${workspaceFolder}/config.toml && python3 -m pipeline.sync_to_fcitx && python3 -m pipeline.rime_import_safe"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
